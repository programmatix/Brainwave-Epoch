{
  "name": "nw-react-example",
  "version": "0.1.3",
  "main": "main.js",
  "homepage": ".",
  "window": {
    "icon": "./build/logo512.png",
    "toolbar": true,
    "show": true,
    "width": 1200,
    "height": 800
  },
  "remote-debugging-port": 9222,
  "webkit": {
    "plugin": true
  },
  "chromium-args": "--enable-logging --remote-debugging-port=9222 --disable-web-security --allow-running-insecure-content --disable-features=VizDisplayCompositor",
  "node-remote": [
    "http://127.0.0.1:3042",
    "file://*"
  ],
  "private": true,
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "customize-cra": "^1.0.0",
    "nw": "0.89.0-sdk",
    "nw-builder": "^4.13.14",
    "postcss": "^8.5.5",
    "postcss-cli": "^11.0.1",
    "react": "^18.3.1",
    "react-app-rewired": "^2.2.1",
    "react-devtools": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "wait-on": "^8.0.3",
    "web-vitals": "^5.0.3"
  },
  "scripts": {
    "dev": "concurrently -k \"npm start\" \"wait-on http://127.0.0.1:3042 && cross-env NWJS_START_URL=http://127.0.0.1:3042 nw --no-sandbox --disable-gpu .\"",
    "dev-chrome": "./chromium-dev.sh",
    "dev-chrome-profiler": "./chromium-dev-profiler.sh",
    "dev-chrome-ext": "./chromium-dev-with-extension.sh",
    "dev2": "concurrently -k \"cross-env NWJS_START_URL=http://127.0.0.1:3043 nw --enable-logging=stderr --remote-debugging-port=9222 .\"",
    "dev-tools": "concurrently -k \"react-devtools\" \"cross-env REACT_APP_DEVTOOLS=enabled npm start\" \"wait-on http://127.0.0.1:3042 && cross-env NWJS_START_URL=http://127.0.0.1:3042 nw --enable-logging=stderr --remote-debugging-port=9222 .\"",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "predist": "cross-env GENERATE_SOURCEMAP=false BUILD_PATH=./dist/app/build/ npm run build",
    "dist": "node dist.mjs"
  },
  "build": {
    "manifestProps": [
      "name",
      "version",
      "main",
      "node-remote",
      "window"
    ],
    "osTypes": [
      "windows"
    ]
  },
  "eslintConfig": {
    "globals": {
      "nw": true
    },
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@tippyjs/react": "^4.2.6",
    "@types/d3": "^7.4.3",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-style": "^0.5.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "csv-parse": "^5.6.0",
    "d3": "^7.9.0",
    "dotenv": "^16.5.0",
    "file-saver": "^2.0.5",
    "plotly": "^1.0.6",
    "plotly.js": "^3.0.1",
    "react-chartjs-2": "^5.3.0",
    "react-plotly.js": "^2.6.0",
    "react-toastify": "^11.0.5",
    "stream-browserify": "^3.0.0",
    "tippy.js": "^6.3.7",
    "zustand": "^4.5.5"
  }
}
