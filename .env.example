# Video and Audio Server Configuration
# Set these environment variables to configure the video/audio server URL
# If not set, defaults to http://192.168.1.180:5000

# Video server URL (for loading video files)
REACT_APP_VIDEO_SERVER_URL=http://192.168.1.180:5000

# Audio server URL (for loading audio files) 
# If not set, will use REACT_APP_VIDEO_SERVER_URL as fallback
REACT_APP_AUDIO_SERVER_URL=http://192.168.1.180:5000

# To disable video/audio loading entirely, you can set these to empty values:
# REACT_APP_VIDEO_SERVER_URL=
# REACT_APP_AUDIO_SERVER_URL=